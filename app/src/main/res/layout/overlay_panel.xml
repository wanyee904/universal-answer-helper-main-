<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#80111111"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 标题栏：状态 + 右上角收起 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="等待识别题目…"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="◀"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="▶"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_collapse"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="^"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 工具栏：识别 / 框题 / 编辑 / 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_capture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="30dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="识别"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_region"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="30dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="框题"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_edit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="30dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="编辑"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="30dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="✕"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 题型选择 -->
    <LinearLayout
        android:id="@+id/type_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_type_choice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="28dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="选择题"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_type_judge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="28dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="判断题"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_type_essay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="28dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="大题"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_type_translate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="28dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="翻译"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 内容区：最高 1/3 屏，超出滚动 -->
    <com.example.answerhelper.auto.MaxHeightScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="8"
                android:textColor="#EEFFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#BBFFFFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/edit_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/option_count_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选项数量（2-26）"
                        android:textColor="#EEFFFFFF"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_option_count"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:hint="4"
                        android:inputType="number"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_stem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minLines="2"
                    android:maxLines="6"
                    android:gravity="top"
                    android:hint="题干区 / 主题干区"
                    android:inputType="textMultiLine"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minLines="2"
                    android:maxLines="4"
                    android:gravity="top"
                    android:hint="问题区（大题，可留空，留空则主题干即问题）"
                    android:inputType="textMultiLine"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_judge_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="选项：是 / 否"
                    android:textColor="#EEFFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/options_edit_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/options_edit_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_add_option"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="28dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="＋选项"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_remove_option"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:minHeight="28dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="－选项"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_edit_cancel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="28dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="取消"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_edit_confirm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:minHeight="28dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="确认并解题"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.example.answerhelper.auto.MaxHeightScrollView>
</LinearLayout>
