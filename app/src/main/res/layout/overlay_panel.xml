<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_panel"
    android:elevation="8dp"
    android:padding="8dp">

    <!-- 标题栏：状态 + 右上角收起 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="等待识别题目…"
            android:textColor="@color/md_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_prev"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="◀"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="▶"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_collapse"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="^"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 工具栏：识别 / 框题 / 编辑 / 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_capture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="30dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="识别"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btn_region"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="30dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="框题"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btn_edit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="30dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="编辑"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btn_resolve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="30dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="重新解题"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="30dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="✕"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 单选 / 多选（仅选择题显示） -->
    <LinearLayout
        android:id="@+id/choice_mode_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_choice_single"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="28dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="单选题"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_choice_multi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_overlay_btn_md"
            android:minHeight="28dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="多选题"
            android:textAllCaps="false"
            android:textColor="@color/md_on_surface"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 题型选择：只显示已开启的功能，按钮等宽，超出横向滚动 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/type_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_type_choice"
                android:layout_width="88dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_overlay_btn_md"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="选择题"
                android:textAllCaps="false"
                android:textColor="@color/md_on_surface"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btn_type_judge"
                android:layout_width="88dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_overlay_btn_md"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="判断题"
                android:textAllCaps="false"
                android:textColor="@color/md_on_surface"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btn_type_essay"
                android:layout_width="88dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_overlay_btn_md"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="大题"
                android:textAllCaps="false"
                android:textColor="@color/md_on_surface"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btn_type_cloze"
                android:layout_width="88dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_overlay_btn_md"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="完型填空"
                android:textAllCaps="false"
                android:textColor="@color/md_on_surface"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btn_type_clipboard"
                android:layout_width="88dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_overlay_btn_md"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="剪贴板"
                android:textAllCaps="false"
                android:textColor="@color/md_on_surface"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_type_translate"
                android:layout_width="88dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_overlay_btn_md"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="翻译"
                android:textAllCaps="false"
                android:textColor="@color/md_on_surface"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/clip_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_translate_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击条目即复制到输入法剪贴板（数量不限）"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/clip_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>


    <!-- 翻译结果区：两块整篇文本（译文 / 原文），各自可滚，不跟随源页面滚动 -->
    <LinearLayout
        android:id="@+id/translate_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_translate_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_translate_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="译文"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_mode_translated"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_mode_chip"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="译文"
                android:textAllCaps="false"
                android:textColor="@color/md_on_primary_container"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_mode_original"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mode_chip"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="原文"
                android:textAllCaps="false"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <com.example.answerhelper.auto.MaxHeightScrollView
            android:id="@+id/translate_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/translate_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_translate_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/md_on_surface"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.example.answerhelper.auto.MaxHeightScrollView>

        <com.example.answerhelper.auto.MaxHeightScrollView
            android:id="@+id/translate_original_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/translate_original_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_original_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.example.answerhelper.auto.MaxHeightScrollView>
    </LinearLayout>

    <!-- 内容区：最高 1/3 屏，超出滚动 -->
    <com.example.answerhelper.auto.MaxHeightScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="8"
                android:textColor="@color/md_on_surface"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/edit_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/option_count_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选项数量（2-26）"
                        android:textColor="@color/md_on_surface"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_option_count"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="4"
                        android:inputType="number"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/md_on_surface"
                        android:textColorHint="@color/md_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 编辑框操作：全选 / 复制 / 粘贴 -->
                <LinearLayout
                    android:id="@+id/edit_clip_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_sel_all"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_overlay_btn_md"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="全选"
                        android:textAllCaps="false"
                        android:textColor="@color/md_on_surface"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_copy"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_overlay_btn_md"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="复制"
                        android:textAllCaps="false"
                        android:textColor="@color/md_on_surface"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_paste"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_overlay_btn_md"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="粘贴"
                        android:textAllCaps="false"
                        android:textColor="@color/md_on_surface"
                        android:textSize="11sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_stem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="top"
                    android:hint="题干区 / 主题干区"
                    android:inputType="textMultiLine"
                    android:longClickable="true"
                    android:maxLines="6"
                    android:minLines="2"
                    android:padding="8dp"
                    android:textColor="@color/md_on_surface"
                    android:textColorHint="@color/md_on_surface_variant"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:gravity="top"
                    android:hint="问题区（大题，可留空，留空则主题干即问题）"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minLines="2"
                    android:padding="8dp"
                    android:textColor="@color/md_on_surface"
                    android:textColorHint="@color/md_on_surface_variant"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_judge_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="选项：是 / 否"
                    android:textColor="@color/md_on_surface"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/options_edit_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/options_edit_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_add_option"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_overlay_btn_md"
                        android:minHeight="28dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="＋选项"
                        android:textAllCaps="false"
                        android:textColor="@color/md_on_surface"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_remove_option"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_overlay_btn_md"
                        android:minHeight="28dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="－选项"
                        android:textAllCaps="false"
                        android:textColor="@color/md_on_surface"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_edit_cancel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_overlay_btn_md"
                        android:minHeight="28dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="取消"
                        android:textAllCaps="false"
                        android:textColor="@color/md_on_surface"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_edit_confirm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_overlay_btn_md"
                        android:minHeight="28dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="确认并解题"
                        android:textAllCaps="false"
                        android:textColor="@color/md_on_surface"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.example.answerhelper.auto.MaxHeightScrollView>
</LinearLayout>
